#!/usr/bin/env bash
# OpenShift Build Data Migration Tool
# Migrate hermetic build configurations between OpenShift versions

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/git-utils.sh
source "$SCRIPT_DIR/lib/git-utils.sh"
# shellcheck source=lib/yaml-utils.sh
source "$SCRIPT_DIR/lib/yaml-utils.sh"

# Default values
VERBOSE=false
DEBUG=false
DRY_RUN=false
FORCE=false
OUTPUT_FORMAT="table"
COMMAND=""
WORKING_DIR="$MULTI_DIR/working"

# Help function
show_help() {
    cat << EOF
OpenShift Build Data Migration Tool

DESCRIPTION:
    Migrate hermetic build configurations from source version to target version(s).
    Identifies images that are hermetic in source but still open in target, then
    applies the complete set of configuration changes needed for hermetic builds.

USAGE:
    ocp-migrate [COMMAND] [OPTIONS] [ARGS...]

COMMANDS:
    detect <source-version> <target-versions>           Detect images needing migration
    diff <image> <source-version> <target-version>      Show complete YAML diff for image
    apply <image> <source-version> <target-version>     Apply migration for single image
    bulk <source-version> <target-versions> [options]   Migrate multiple images
    clean                                               Clean working directory
    validate <version>                                  Validate working directory changes

OPTIONS:
    -f, --format <format>     Output format: table, json, csv (default: table)
    -n, --dry-run            Preview changes without applying them
    --force                  Force operation (overwrite existing files)
    -v, --verbose            Enable verbose output
    -d, --debug              Enable debug output
    -h, --help               Show this help message

EXAMPLES:
    # Detect images that need migration from 4.19 to 4.18
    ocp-migrate detect 4.19 4.18

    # See what changes would be applied to multus-cni
    ocp-migrate diff multus-cni 4.19 4.18

    # Preview migration without applying changes
    ocp-migrate apply multus-cni 4.19 4.18 --dry-run

    # Apply migration for single image
    ocp-migrate apply multus-cni 4.19 4.18

    # Migrate all detected candidates
    ocp-migrate bulk 4.19 4.18

    # Migrate with filtering
    ocp-migrate bulk 4.19 4.18 --filter "multus-*,ose-baremetal-*"

    # Clean working directory
    ocp-migrate clean

MIGRATION PROCESS:
    1. Uses existing 'ocp-hermetic candidates' to identify images
    2. Finds images that are 'OK' (hermetic) in source but 'OPEN' in target
    3. Analyzes complete YAML differences between versions
    4. Applies all hermetic-related changes (network_mode, cachi2, RPMs, etc.)
    5. Validates YAML syntax and semantic correctness
    6. Always maintains clean working directory state

WORKING DIRECTORY:
    - Uses temporary 'working/' directory for modifications
    - Automatically cleaned before and after operations
    - Read-only 'versions/' directory remains unchanged
    - Atomic operations with rollback on failure

$(show_common_help)
EOF
}

# Parse command line arguments
parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -f|--format)
                OUTPUT_FORMAT="$2"
                shift 2
                ;;
            -n|--dry-run)
                DRY_RUN=true
                shift
                ;;
            --force)
                FORCE=true
                shift
                ;;
            -v|--verbose)
                VERBOSE=true
                shift
                ;;
            -d|--debug)
                DEBUG=true
                export DEBUG=1
                shift
                ;;
            detect|diff|apply|bulk|clean|validate)
                COMMAND="$1"
                shift
                break
                ;;
            *)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    # Store remaining arguments for command-specific parsing
    REMAINING_ARGS=("$@")
}

# Setup cleanup trap
setup_cleanup_trap() {
    local cleanup_func="$1"
    trap "$cleanup_func" EXIT INT TERM
}

# Clean working directory
clean_working_directory() {
    if [[ -d "$WORKING_DIR" ]]; then
        log_debug "Cleaning working directory: $WORKING_DIR"
        rm -rf "$WORKING_DIR"/*
    fi
}

# Create clean working directory
create_working_directory() {
    clean_working_directory
    log_debug "Creating clean working directory: $WORKING_DIR"
    mkdir -p "$WORKING_DIR"
}

# Fix YAML formatting issues using yamlfmt
fix_yaml_formatting() {
    local file="$1"
    
    log_debug "Fixing YAML formatting in $file using yamlfmt"
    
    # Use yamlfmt with configuration file
    if command -v yamlfmt >/dev/null 2>&1; then
        yamlfmt "$file"
    else
        log_warning "yamlfmt not found, skipping formatting fixes"
        log_info "Run 'make setup' to install yamlfmt"
    fi
}

# Create working directory with git setup
create_working_directory_with_git() {
    local target_version="$1"
    
    # Clean and create the working directory (no version subdirectory)
    clean_working_directory
    
    log_debug "Creating working directory with git setup: $WORKING_DIR"
    mkdir -p "$WORKING_DIR"
    
    # Setup git repository in the working directory (capture output)
    local git_output
    git_output=$(setup_working_git "$WORKING_DIR" 2>&1)
    
    # Create migration branch (capture output)
    local branch_name
    branch_name=$(create_migration_branch "$WORKING_DIR" "$target_version" 2>/dev/null)
    if [[ -z "$branch_name" ]]; then
        log_error "Failed to create migration branch"
        return 1
    fi
    
    log_info "Working directory ready with branch: $branch_name"
    echo "$branch_name"
}

# Detect command - find migration candidates
detect_command() {
    local args=("$@")
    local quiet_mode="${3:-false}"
    
    if [[ ${#args[@]} -lt 2 ]]; then
        log_error "detect command requires: <source-version> <target-versions>"
        show_help
        exit 1
    fi
    
    local source_version="${args[0]}"
    local target_versions="${args[1]}"
    
    if [[ "$quiet_mode" != "true" ]]; then
        log_info "Detecting migration candidates from $source_version to $target_versions"
    fi
    
    # Use existing ocp-hermetic candidates to get the data
    local candidates_output
    if ! candidates_output=$("$SCRIPT_DIR/ocp-hermetic" candidates "$source_version,$target_versions" 2>/dev/null); then
        log_error "Failed to get candidates from ocp-hermetic command"
        exit 1
    fi
    
    # Parse output and find images that are OK in source but OPEN in target
    echo "$candidates_output" | while IFS= read -r line; do
        # Skip header lines
        [[ "$line" =~ ^[[:space:]]*IMAGE|^[[:space:]]*--- ]] && continue
        [[ -z "$line" ]] && continue
        
        # Extract image name and status columns
        local image_name
        image_name=$(echo "$line" | awk '{print $1}')
        
        # Check if this line contains the pattern we want (OK in source, OPEN in target)
        if echo "$line" | grep -q "OK.*OPEN"; then
            echo "$image_name"
        fi
    done
}

# Diff command - show YAML differences
diff_command() {
    local args=("$@")
    
    if [[ ${#args[@]} -lt 3 ]]; then
        log_error "diff command requires: <image> <source-version> <target-version>"
        show_help
        exit 1
    fi
    
    local image_name="${args[0]}"
    local source_version="${args[1]}"
    local target_version="${args[2]}"
    
    local source_file="$VERSIONS_DIR/$source_version/images/${image_name}.yml"
    local target_file="$VERSIONS_DIR/$target_version/images/${image_name}.yml"
    
    if [[ ! -f "$source_file" ]]; then
        log_error "Source image file not found: $source_file"
        exit 1
    fi
    
    if [[ ! -f "$target_file" ]]; then
        log_error "Target image file not found: $target_file"
        exit 1
    fi
    
    log_info "Showing differences for $image_name between $source_version and $target_version"
    echo
    echo "=== YAML Diff: $image_name ===" 
    echo "Source: $source_version (hermetic)"
    echo "Target: $target_version (needs migration)"
    echo
    
    # Show unified diff
    diff -u "$target_file" "$source_file" || true
}

# Apply command - apply migration for single image
apply_command() {
    local args=("$@")
    
    if [[ ${#args[@]} -lt 3 ]]; then
        log_error "apply command requires: <image> <source-version> <target-version>"
        show_help
        exit 1
    fi
    
    local image_name="${args[0]}"
    local source_version="${args[1]}"
    local target_version="${args[2]}"
    
    log_info "Applying migration for $image_name from $source_version to $target_version"
    
    if [[ "$DRY_RUN" == "true" ]]; then
        log_info "DRY RUN: Would apply migration for $image_name"
        echo
        diff_command "$image_name" "$source_version" "$target_version"
        echo
        log_info "DRY RUN: No files were modified"
        return 0
    fi
    
    local source_file="$VERSIONS_DIR/$source_version/images/${image_name}.yml"
    local target_file="$VERSIONS_DIR/$target_version/images/${image_name}.yml"
    local working_target_dir="$WORKING_DIR/images"
    local working_file="$working_target_dir/${image_name}.yml"
    
    # Validate source and target files exist
    if [[ ! -f "$source_file" ]]; then
        log_error "Source image file not found: $source_file"
        exit 1
    fi
    
    if [[ ! -f "$target_file" ]]; then
        log_error "Target image file not found: $target_file"
        exit 1
    fi
    
    # Create working directory structure
    mkdir -p "$working_target_dir"
    
    # Copy target file to working location first (preserves all non-konflux changes)
    cp "$target_file" "$working_file"
    
    # Apply konflux migration: check if source has konflux section
    local source_has_konflux
    source_has_konflux=$(yq eval '.konflux' "$source_file")
    
    # If source has no konflux section (uses default hermetic), remove konflux from target
    if [[ "$source_has_konflux" == "null" ]]; then
        log_debug "Removing konflux section to enable hermetic mode"
        yq eval 'del(.konflux)' -i "$working_file"
    else
        # Copy only the konflux section from source to target
        log_debug "Copying konflux section from source"
        local source_konflux
        source_konflux=$(yq eval '.konflux' "$source_file")
        if [[ "$source_konflux" != "null" ]]; then
            yq eval ".konflux = $source_konflux" -i "$working_file"
        fi
    fi
    
    # Fix YAML formatting issues introduced by yq
    fix_yaml_formatting "$working_file"
    
    log_success "Migration applied for $image_name"
    log_info "Migrated file: $working_file"
    log_info "Original target: $target_file"
    
    echo
    log_info "Migration summary:"
    echo "  Source (hermetic): $source_file"
    echo "  Target (to migrate): $target_file" 
    echo "  Result: $working_file"
    echo
    log_info "To see the changes that were applied:"
    echo "  ./tools/ocp-migrate diff $image_name $target_version $source_version"
}

# Bulk command - migrate multiple images
bulk_command() {
    local args=("$@")
    
    if [[ ${#args[@]} -lt 2 ]]; then
        log_error "bulk command requires: <source-version> <target-versions>"
        show_help
        exit 1
    fi
    
    local source_version="${args[0]}"
    local target_versions="${args[1]}"
    
    log_info "Starting bulk migration from $source_version to $target_versions"
    
    # Get list of candidates by calling ocp-hermetic directly
    local candidates
    log_debug "Running candidate detection..."
    
    # Call ocp-hermetic candidates directly and parse output
    local hermetic_output
    if ! hermetic_output=$("$SCRIPT_DIR/ocp-hermetic" candidates "$source_version,$target_versions" 2>/dev/null); then
        log_error "Failed to get candidates from ocp-hermetic command"
        exit 1
    fi
    
    # Parse output to find images that are OK in source but OPEN in target
    candidates=""
    while IFS= read -r line; do
        # Skip header lines
        [[ "$line" =~ ^[[:space:]]*IMAGE|^[[:space:]]*--- ]] && continue
        [[ -z "$line" ]] && continue
        
        # Check if this line contains the pattern we want (OK in source, OPEN in target)
        if echo "$line" | grep -q "OK.*OPEN"; then
            local image_name
            image_name=$(echo "$line" | awk '{print $1}')
            if [[ -n "$candidates" ]]; then
                candidates="$candidates"$'\n'"$image_name"
            else
                candidates="$image_name"
            fi
        fi
    done <<< "$hermetic_output"
    
    log_debug "Candidates detected successfully"
    
    if [[ -z "$candidates" ]]; then
        log_info "No migration candidates found"
        return 0
    fi
    
    local candidate_count
    candidate_count=$(echo "$candidates" | wc -l | xargs)
    
    log_info "Found $candidate_count migration candidates:"
    while IFS= read -r image_name; do
        [[ -n "$image_name" ]] && echo "  - $image_name"
    done <<< "$candidates"
    echo
    
    # Setup git repository for target version (assuming single target version for now)
    local migration_branch
    if [[ "$DRY_RUN" != "true" ]]; then
        log_info "Setting up git repository for migration"
        if ! migration_branch=$(create_working_directory_with_git "$target_versions" 2>/dev/null | tail -1); then
            log_error "Failed to setup git repository"
            exit 1
        fi
        log_info "Migration branch created: $migration_branch"
        echo
    fi
    
    # Process each candidate
    local success_count=0
    local total_count=0
    
    log_debug "Starting to process candidates..."
    
    # Process candidates using array instead of here-string
    local candidate_list
    readarray -t candidate_list <<< "$candidates"
    total_count=${#candidate_list[@]}
    
    # Remove empty elements
    local cleaned_candidates=()
    for candidate in "${candidate_list[@]}"; do
        [[ -n "$candidate" ]] && cleaned_candidates+=("$candidate")
    done
    
    total_count=${#cleaned_candidates[@]}
    
    local i=1
    for image_name in "${cleaned_candidates[@]}"; do
        log_info "Processing $image_name ($i/$total_count)..."
        
        if [[ "$DRY_RUN" == "true" ]]; then
            log_info "DRY RUN: Would migrate $image_name"
            success_count=$i
        else
            set +e  # Temporarily disable exit on error
            apply_command "$image_name" "$source_version" "$target_versions"
            local apply_result=$?
            set -e  # Re-enable exit on error
            
            if [[ $apply_result -eq 0 ]]; then
                success_count=$i
                log_success "✓ $image_name migrated successfully"
            else
                log_error "✗ Failed to migrate $image_name"
            fi
        fi
        
        echo
        ((i++))
    done
    
    log_info "Bulk migration completed: $success_count/$total_count images processed successfully"
    
    # Show git status and next steps if we have any successful migrations
    if [[ "$DRY_RUN" != "true" ]] && [[ $success_count -gt 0 ]]; then
        echo
        log_info "Migration completed. Working directory ready for review:"
        echo "  Directory: $WORKING_DIR"
        echo "  Branch: $migration_branch"
        echo
        log_info "To review changes:"
        echo "  cd $WORKING_DIR"
        echo "  git status"
        echo "  git diff"
        echo
        log_info "After reviewing, to commit and create PR:"
        echo "  git add ."
        echo "  git commit -m \"feat: migrate hermetic builds for OpenShift $target_versions\""
        echo "  git push -u $PERSONAL_REMOTE $migration_branch"
        echo "  gh pr create --title \"feat: migrate hermetic builds for OpenShift $target_versions\" --head ${GITHUB_ACCOUNT}:$migration_branch --base openshift-$target_versions"
    fi
    
    # Output comma-separated list of migration candidates (last thing in output)
    echo
    if [[ -n "$candidates" ]]; then
        # Convert newline-separated list to comma-separated
        local comma_separated
        comma_separated=$(echo "$candidates" | tr '\n' ',' | sed 's/,$//')
        echo "$comma_separated"
    fi
}

# Clean command - clean working directory
clean_command() {
    log_info "Cleaning working directory"
    clean_working_directory
    log_success "Working directory cleaned"
}

# Validate command - validate working directory
validate_command() {
    local args=("$@")
    local version="${args[0]:-}"
    
    if [[ -z "$version" ]]; then
        log_error "validate command requires: <version>"
        exit 1
    fi
    
    if [[ ! -d "$WORKING_DIR" ]]; then
        log_error "No working directory found"
        exit 1
    fi
    
    log_info "Validating working directory for version $version"
    
    local error_count=0
    
    # Validate YAML syntax for all files
    find "$WORKING_DIR" -name "*.yml" -type f | while read -r file; do
        if ! yq eval '.' "$file" >/dev/null 2>&1; then
            log_error "Invalid YAML syntax: $file"
            ((error_count++))
        else
            log_debug "Valid YAML: $file"
        fi
    done
    
    if [[ $error_count -eq 0 ]]; then
        log_success "All files in working directory are valid"
    else
        log_error "Found $error_count files with validation errors"
        exit 1
    fi
}

# Main function
main() {
    # Check dependencies
    if ! check_dependencies; then
        exit 1
    fi
    
    # Parse command line arguments
    parse_args "$@"
    
    # Set verbose mode
    if [[ "$VERBOSE" == "true" ]]; then
        set -x
    fi
    
    # Execute command
    case "$COMMAND" in
        "detect")
            detect_command "${REMAINING_ARGS[@]}"
            ;;
        "diff")
            diff_command "${REMAINING_ARGS[@]}"
            ;;
        "apply")
            apply_command "${REMAINING_ARGS[@]}"
            ;;
        "bulk")
            bulk_command "${REMAINING_ARGS[@]}"
            ;;
        "clean")
            clean_command "${REMAINING_ARGS[@]}"
            ;;
        "validate")
            validate_command "${REMAINING_ARGS[@]}"
            ;;
        "")
            log_error "No command specified"
            show_help
            exit 1
            ;;
        *)
            log_error "Unknown command: $COMMAND"
            show_help
            exit 1
            ;;
    esac
}

# Run main function if script is executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi